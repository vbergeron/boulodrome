# Variant metadata for the opam-repository "+9.0" submission of this
# release. Not used by `dune build` directly (boulodrome.opam at the repo
# root is what dune-project generates and what CI/local dev use) - this
# file is passed to `opam publish` so opam-repository gets a package that
# is tightly bound to the coq-lsp/Rocq 9.0 line, and whose first build
# step swaps in the matching Loadpath.vo_path shape. See
# lib/dune_loadpath_record.9_0.ml.inc for why the swap is needed.
opam-version: "2.0"
synopsis: "MCP server for Rocq/Coq proof assistance via Petanque"
description:
  "Boulodrome gives LLMs interactive access to the Rocq proof assistant through the Model Context Protocol (MCP). It exposes tools for starting proof sessions, running tactics, inspecting goals, searching the library, and undoing steps, turning theorem proving into a tool-calling loop."
maintainer: ["Valentin Bergeron <dev.vbergeron@gmail.com>"]
authors: ["Valentin Bergeron <dev.vbergeron@gmail.com>"]
license: "Apache-2.0"
homepage: "https://github.com/vbergeron/boulodrome"
bug-reports: "https://github.com/vbergeron/boulodrome/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.1"}
  "yojson"
  "logs"
  "coq-lsp" {>= "0.2.5"}
  "rocq-core" {>= "9.0" & < "9.1"}
  "odoc" {with-doc}
]
build: [
  ["cp" "lib/dune_loadpath_record.9_0.ml.inc" "lib/dune_loadpath_record.ml"]
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/vbergeron/boulodrome.git"
x-maintenance-intent: ["(latest)"]
